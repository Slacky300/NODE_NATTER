{
    "builds": [
      {
        "src": "frontend/package.json",
        "use": "@vercel/static-build"
      },
      {
        "src": "backend/package.json",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      { "src": "/static/(.*)", "dest": "/backend/public/static/$1" },
      { "src": "/(.*)", "dest": "/backend/$1" }
    ]
  }
  